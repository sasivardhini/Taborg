{
  "manifest_version": 3,
  "name": "Taborg - Tab & Window Organizer",
  "version": "1.0.0",
  "description": "Professional tab management with grouping, session saving, duplicate detection, and intelligent cleanup. Boost your productivity and organize your browser.",
  "author": "Taborg Team",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Taborg - Organize Your Tabs"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "tabGroups",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Open Taborg"
    },
    "save_session": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick save current session"
    },
    "close_duplicates": {
      "suggested_key": {
        "default": "Ctrl+Shift+D",
        "mac": "Command+Shift+D"
      },
      "description": "Close duplicate tabs"
    }
  },
  "minimum_chrome_version": "88"
}
